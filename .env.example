# Copy to .env and fill in. Never commit .env.

# Instagram login (use a dedicated scraping account, not your main one)
IG_USERNAME=your_username
IG_PASSWORD=your_password

# Max rounds of scroll / load more / expand replies
LOAD_COMMENT_CLICKS=10
# Max comments to scrape, 0 = unlimited
MAX_COMMENTS=0
# 1 = also open "View hidden comments" and scrape them (extra column "hidden" in the output)
INCLUDE_HIDDEN_COMMENTS=1

# Pauses / waits (seconds)
SLEEP_SCROLL_SECONDS=2
SLEEP_CLICK_SECONDS=0.5
SLEEP_AFTER_LOGIN_SECONDS=2
WAIT_COMMENTS_SECONDS=6
